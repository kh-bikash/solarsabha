# Live agent mode only. Offline demo needs none of this.
AWS_REGION=ap-south-1
STATE_BACKEND=local          # 'dynamodb' on AWS (set automatically by template.yaml)
LOCAL_STATE_DIR=.state
READER_MODE=live             # 'offline' = plain-rule reader, no AI
MODEL_PROVIDER=gemini        # or 'bedrock'
GEMINI_API_KEY=              # Google AI Studio key
# GEMINI_MODEL_ID=           # optional: comma-separated fallback chain (default: 7 models, see agents/factory.py)
BAZAARLINK_API_KEY=          # optional backup for the text agents
BEDROCK_MODEL_ID=            # only with MODEL_PROVIDER=bedrock: a model or inference profile enabled for YOUR account
